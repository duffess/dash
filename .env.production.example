# Copy to .env.production (ignored). Never add real values to this example.
APP_ENV=production
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
FRONTEND_BASE_URL=https://app.example.com
GOOGLE_ADS_REDIRECT_URI=https://api.example.com/auth/google/callback
META_REDIRECT_URI=https://api.example.com/auth/meta/callback
CORS_ORIGINS=["https://app.example.com"]
TRUSTED_HOSTS=["api.example.com"]
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEMO_AI_ENABLED=false
RATE_LIMIT_ENABLED=true
MAX_REQUEST_BYTES=262144
AUTH_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_MINUTE=5
API_REQUESTS_PER_MINUTE=180
# DATABASE_URL, SECRET_KEY, TOKEN_ENCRYPTION_KEY, OPS_METRICS_TOKEN come from files.
